# ─────────────────────────────────────────────
# TripVlog Backend — Required Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/tripvlog

# Redis connection string (used by BullMQ + SSE progress pub/sub)
REDIS_URL=redis://localhost:6379

# Google OAuth2 credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# GCP Cloud Storage bucket for ingested media files
GCS_BUCKET_NAME=

# AES-256-GCM key for encrypting OAuth tokens at rest
# Must be exactly 32 bytes encoded as 64 hex characters
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex') |> console.log"
TOKEN_ENCRYPTION_KEY=

# JWT signing secret for session cookies
# Generate with: node -e "require('crypto').randomBytes(64).toString('hex') |> console.log"
JWT_SECRET=

# Gemini 1.5 Pro API key (used by AI Engineer service)
GEMINI_API_KEY=

# Internal URL of the Python AI microservice (metadata extraction + analysis)
AI_SERVICE_URL=http://localhost:8000

# Google Maps Geocoding API key (for reverse-geocoding GPS coordinates)
GOOGLE_MAPS_API_KEY=

# Maximum total folder size per project in gigabytes (default: 5)
MAX_PROJECT_SIZE_GB=5

# Node environment
NODE_ENV=development

# Express server port
PORT=3001
